{
  "name": "stimma-shell",
  "productName": "Stimma",
  "desktopName": "ai.stimma.stimma.debug.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Stimma desktop shell (Electron main + preload)",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:update-linux": "node scripts/test-appimage-update.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
