{
  "name": "stimma-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stimma-ai/stimma.git"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:pin-lock": "node --test tests/pinLockPrivacy.browser.test.mjs tests/pinLockLayout.browser.test.mjs",
    "test:mobile-experience": "node --test tests/mobileAutofocus.browser.test.mjs tests/mobileMediaActions.browser.test.mjs tests/mobileSafeArea.browser.test.mjs tests/jobsStrip.browser.test.mjs",
    "test:chat-drafts": "node --test tests/chatDrafts.browser.test.mjs",
    "test:chat-performance": "node --test tests/chatPerformance.test.mjs tests/chatPerformance.browser.test.mjs",
    "build:seamless-patch-wasm": "bash scripts/build-seamless-patch-wasm.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:dead-code": "knip --include files --no-progress",
    "test:sprites": "node --test src/utils/spritePlayback.test.js tests/spritePlayer.test.mjs",
    "test:project-world": "node --test --experimental-strip-types src/utils/workingContext.test.ts src/utils/initialMessage.test.ts src/utils/projectActivity.test.ts src/utils/searchScope.test.ts",
    "test:handoff": "node --test --experimental-strip-types src/utils/toolHandoff.test.ts",
    "test:project-scope": "node --test --experimental-strip-types src/utils/projectScope.test.ts src/utils/filterFacetState.test.js",
    "test:agent-unavailable": "node --test --experimental-strip-types src/utils/agentUnavailableState.test.ts",
    "test:settings-readiness": "node --test --experimental-strip-types src/utils/settingsReadiness.test.ts",
    "test:task-type-validation": "node --test --experimental-strip-types src/utils/taskTypeValidation.test.ts",
    "test:update-schedule": "node --test --experimental-strip-types src/utils/updateCheckSchedule.test.ts",
    "test:server-update-check": "node --test --experimental-strip-types src/utils/serverUpdateCheck.test.ts",
    "test:editor-shelf": "node --test --experimental-strip-types src/utils/editorShelf.test.ts",
    "test:database-cleanup": "node --test tests/databaseCleanupState.test.mjs",
    "test:storage-migration": "node --test tests/storageMigration.browser.test.mjs",
    "test:crop-rotation": "node --test tests/cropRotation.browser.test.mjs",
    "test:crop-input": "node --test --experimental-strip-types tests/cropInput.test.mjs",
    "test:image-stack": "node --test --experimental-strip-types src/imageEditor/stack/*.test.ts",
    "test:desktop-bridge": "node --test --experimental-strip-types src/desktop/bridge.test.ts src/desktop/exportPaths.test.ts",
    "test:terms": "node --test --experimental-strip-types src/utils/terms.test.ts",
    "test:directory-picker": "node --test --experimental-strip-types src/utils/directoryPicker.test.ts",
    "test:file-refs": "node --test tests/fileRefs.browser.test.mjs",
    "test:package-cover": "node --test tests/packageCover.test.mjs",
    "test:package-appearance": "node --test tests/packageAppearance.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dagrejs/dagre": "^3.0.0",
    "@heroicons/vue": "^2.2.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "axios": "^1.6.2",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "marked": "^17.0.1",
    "modern-screenshot": "^4.7.0",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tauri-apps/cli": "^2.9.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.16",
    "knip": "^6.17.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^8.0.16"
  }
}
