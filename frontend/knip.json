{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/mobile/main.ts",
    "src/components/feedback/{Official,Source}*.vue",
    "e2e/docs-shots/playwright.config.ts",
    "e2e/docs-shots/setup.ts",
    "e2e/docs-shots/shots/**/*.ts",
    "acceptance/playwright.config.ts",
    "acceptance/playwright.electron.config.ts",
    "acceptance/helpers/global-setup.ts",
    "acceptance/helpers/viewport.ts",
    "acceptance/tests/**/*.ts"
  ],
  "project": [
    "src/**/*.{js,ts,vue}",
    "e2e/docs-shots/**/*.ts",
    "acceptance/**/*.ts",
    "*.config.{js,ts}"
  ],
  "ignoreDependencies": [
    "@crabnebula/tauri-plugin-drag",
    "@tauri-apps/cli",
    "vue-virtual-scroll-grid"
  ]
}
